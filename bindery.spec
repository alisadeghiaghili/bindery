# PyInstaller spec for bindery console executable.
# Build: uv run pyinstaller --clean --noconfirm bindery.spec

block_cipher = None

a = Analysis(
    ['src/bindery/__main__.py'],
    pathex=['src'],
    binaries=[],
    datas=[],
    hiddenimports=['img2pdf', 'PIL', 'pypdf', 'pikepdf'],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='bindery',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
